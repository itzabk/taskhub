# Dependency directories
node_modules/

# Environment variables 
.env
.env.*
!.env.example

# Build files
dist/
build/

# IDE files
# Ignore personal VS Code files
.vscode/*

# Allow the team-critical settings
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Ignore local history and state
.vscode/project-history/
.idea/

# Logs
logs/
*.log
npm-debug.log*

