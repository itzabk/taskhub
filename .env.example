# Node Environment
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration
DB_URL=mongodb://root:rootpassword@mongo-master:27017,mongo-replica-1:27017,mongo-replica-2:27017/taskhub?authSource=admin&replicaSet=rs0
DB_USERNAME=root
DB_PASSWORD=rootpassword
IS_DATABASE_CONNECTION_ENCRYPTED=false
DB_CERT=

# Redis Configuration
REDIS_URL=redis://:redispassword@redis:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=redispassword
IS_REDIS_CONNECTION_ENCRYPTED=false
REDIS_CA=
REDIS_CERT=
REDIS_KEY=

# Express Configuration
EXPRESS_WORKERS=4

# Optional: Client URL for CORS
CLIENT_URL=http://localhost:3000

# Optional: Allowed external origins
ALLOWED_EXTERNAL_ORIGINS=

# Optional: Cookie Secret
COOKIE_SECRET=your-secret-key-here
